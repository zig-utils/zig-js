{
  "$comment": [
    "Project-wide permissions for coding agents. Everything here is read-only",
    "inspection or a verification gate that only reads the tree and writes into",
    "the reproducible .zig-cache / zig-out / dist directories.",
    "",
    "Deliberately NOT allowed, so they always prompt: git commit/push/checkout/",
    "reset, rm, and the corpus gates that spawn and reap process groups",
    "(tools/nogil-corpus-gate.ts, threadfuzz) — those are long, mutually",
    "exclusive jobs that should be started deliberately. Personal additions",
    "belong in .claude/settings.local.json, which is gitignored."
  ],
  "permissions": {
    "allow": [
      "Bash(zig build *)",
      "Bash(zig version)",
      "Bash(zig fmt --check *)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git show*)",
      "Bash(git blame*)",
      "Bash(git remote -v)",
      "Bash(git submodule status*)",
      "Bash(gh issue *)",
      "Bash(gh pr view*)",
      "Bash(gh run list*)",
      "Bash(gh run view*)",
      "Bash(ls *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(wc *)",
      "Bash(pgrep *)",
      "Bash(zig build docs-link-check*)",
      "Bash(*home-tool run tools/release-compatibility.ts*)",
      "Bash(~/Code/Home/lang/zig-out/bin/home-tool run tools/platform-release-matrix.ts*)",
      "Bash(~/Code/Home/lang/zig-out/bin/home-tool run tools/wasm-conformance-matrix.ts*)",
      "Bash(home-tool run tools/threads-reference-audit.ts*)",
      "Bash(~/Code/Home/lang/zig-out/bin/home-tool run tools/verify-c-api.ts*)",
      "Bash(~/Code/Home/lang/zig-out/bin/home-tool run tools/verify-objc-api.ts*)",
      "Bash(~/Code/Home/lang/zig-out/bin/home-tool run tools/verify-abi-profile.ts*)",
      "Bash(bun run docs:build*)",
      "Bash(bun run docs:data*)",
      "Bash(echo \"EXIT=$?\")"
    ]
  }
}
