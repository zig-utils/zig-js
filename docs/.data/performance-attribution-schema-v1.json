{
  "schema_version": 1,
  "profile_id": "zig-js-performance-attribution-v1",
  "owner_issue": 461,
  "history_policy": "Published artifacts retain their original schema and bytes. Any incompatible field, unit, scope, or availability change creates a new profile version.",
  "metric_states": {
    "measured": "value is present and was captured at the declared scope",
    "unavailable": "value is null and a non-empty reason identifies the missing capability, permission, or instrumentation",
    "not_applicable": "value is null and a non-empty reason identifies why the metric has no meaning for this row"
  },
  "sample_identity": [
    "variant",
