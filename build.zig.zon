.{
    .name = .zig_js,
    .version = "0.0.1",
    .fingerprint = 0x18569fa43f653b80,
    .minimum_zig_version = "0.18.0-dev",
    .dependencies = .{
        // Homegrown regex engine, reused to back JS RegExp (pantry: zig-regex).
        .zig_regex = .{
            .url = "https://codeload.github.com/zig-utils/zig-regex/tar.gz/fdd9c2e333ea6ac2fd06d080d939ef7f11d61b1b",
            .hash = "zig_regex-0.2.1-omky0RWyGgAzNOkfsXmYm-kBSWG2aoELeC0IwiirA1cz",
        },
        // Precise tracing GC to unblock Phase 7 (issue #1); see
        // docs/threads/P7-gc-design.md. Opt-in contexts route heap cells
        // through this collector; the binding lives in src/gc.zig.
        .zig_gc = .{
            .url = "https://codeload.github.com/zig-utils/zig-gc/tar.gz/73c802e05768a729614e9c4296abb118aa06faf9",
            .hash = "zig_gc-0.0.1-e4SVfzOmBAAQX82u9LaOnkh6Biqat0pws-6h0pPX2hM6",
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "include",
        // Imported while compiling build.zig, including for module consumers.
        "bench/wasm_threads_comparison.js",
        "README.md",
        "LICENSE",
    },
}
