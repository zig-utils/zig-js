.{
    .name = .zig_js,
    .version = "0.0.1",
    .fingerprint = 0x18569fa43f653b80,
    .minimum_zig_version = "0.18.0-dev",
    .dependencies = .{
        // Homegrown regex engine, reused to back JS RegExp (pantry: zig-regex).
        .zig_regex = .{
            .url = "https://codeload.github.com/zig-utils/zig-regex/tar.gz/732424d1c38197501d9e64c5d4c1dbe7d1a97742",
            .hash = "zig_regex-0.2.1-omky0cHKGwBbh2FCJcgVBCKWHwrfqw4AFk8smB6Qj03k",
        },
        // Precise tracing GC to unblock Phase 7 (issue #1); see
        // docs/threads/P7-gc-design.md. Opt-in contexts route heap cells
        // through this collector; the binding lives in src/gc.zig.
        .zig_gc = .{
            .url = "https://codeload.github.com/zig-utils/zig-gc/tar.gz/9bdb139cb4c6cdaa37b6fa2abebcf549cfe43762",
            .hash = "zig_gc-0.0.1-e4SVf1WzBAA0WpyH09Vg97LmvYYKPjZ9n8LBvrwGxh-V",
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "include",
        // Imported while compiling build.zig, including for module consumers.
        "bench/wasm_threads_comparison.js",
        "README.md",
        "LICENSE",
    },
}
